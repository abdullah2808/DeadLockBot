# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# Discord + database (existing)
DISCORD_TOKEN=
DB_URL=
DB_USER=
DB_PASSWORD=

# Steam bot account for the Deadlock Game Coordinator (Phase B).
# Optional: if unset, the bot falls back to the active-feed match source.
#
# First run: set STEAM_USERNAME + STEAM_PASSWORD and run once interactively to
# answer the Steam Guard prompt. GcClient then saves a refresh token to
# steam_refresh_token.txt (also gitignored). For headless/deployed runs, copy
# that token into STEAM_REFRESH_TOKEN and you can drop STEAM_PASSWORD.
STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_REFRESH_TOKEN=

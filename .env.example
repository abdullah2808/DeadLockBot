# Copy to .env and edit locally. Never share its contents.
DISCORD_TOKEN=
DB_USER=deadlockbot
DB_PASSWORD=
DB_URL=postgresql://localhost:5432/main
IMAGE_TAG=latest
STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_REFRESH_TOKEN=
# Container path under the mounted state directory
STEAM_TOKEN_FILE=/app/state/steam_refresh_token.txt
# Accept incoming requests from tracked accounts or recent /signup attempts (15 minutes).
STEAM_AUTO_ACCEPT_FRIENDS=true
# Fresh GC metadata lookups only; stored API metadata and GC history remain available.
STEAM_METADATA_INTERVAL_SECONDS=1800

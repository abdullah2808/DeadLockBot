# Copy to .env and edit locally. Never share its contents.
DISCORD_TOKEN=
DB_USER=deadlockbot
DB_PASSWORD=
DB_URL=postgresql://localhost:5432/main
IMAGE_TAG=latest
STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_REFRESH_TOKEN=
# Container path under the mounted state directory
STEAM_TOKEN_FILE=/app/state/steam_refresh_token.txt
# Accept incoming requests from tracked accounts or recent /signup attempts (15 minutes).
STEAM_AUTO_ACCEPT_FRIENDS=true
# Fresh GC metadata lookups: at most this many per rolling 24 hours, at least this many seconds apart.
STEAM_METADATA_DAILY_LIMIT=40
STEAM_METADATA_INTERVAL_SECONDS=20
# Optional deadlock-api.com key: Steam-backed metadata lookups rise from 3 to 300 per hour.
DEADLOCK_API_KEY=
# Ask deadlock-api to fetch missing matches from Steam (its quota, not this bot's GC budget).
DEADLOCK_API_STEAM_FALLBACK=true
